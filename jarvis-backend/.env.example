# Real provider key — lives ONLY here, server-side. Never ships in the Android app.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret the Android app sends in the Authorization header.
# This is a basic app-level gate (stops casual abuse of your endpoint), not full user auth.
# For production with many users, replace with per-user auth (Firebase Auth, etc).
APP_SHARED_SECRET=change-me-to-a-long-random-string

PORT=8080
